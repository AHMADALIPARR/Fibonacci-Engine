% EXPECTED TO FAIL: claims B is an involution (B(B(x,y)) = (x,y)); B has order 3, not 2.
braid-involution : braid X Y A B -> braid A B X Y -> type.
%mode braid-involution +D -E.
- : braid-involution (braid/rule V) (braid/rule V') <- xorv-shift V V'.
%worlds () (braid-involution _ _).
%total D (braid-involution D _).
